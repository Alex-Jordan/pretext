#######
# Setup
#######

Context('Numeric');
@a = (random(2,9,1),random(2,9,1));
@b = (random(2,9,1),random(2,9,1));
for my$i(0..3){$p[$i]=$a[int($i/2)]*$b[$i % 2]};

######
# Body
######

BEGIN_PGML
Complete this multiplication table.

[#
    [.[`\times`].]{
      rowbottom => '3',
    }
    [.[`[$a[0]]`].]
    [.[`[$a[1]]`].]*

    [.[`[$b[0]]`].]{
      rowbottom => '1',
    }
    [.[_]{$p[0]}{5}.]
    [.[_]{$p[2]}{5}.]*

    [.[`[$b[1]]`].]{
      rowbottom => '1',
    }
    [.[_]{$p[1]}{5}.]
    [.[_]{$p[3]}{5}.]
#]{
      align => 'r!{\vrule width 0.11em}c|c|',
      valign => 'middle',
}

END_PGML

##########
# Solution
##########

BEGIN_PGML_SOLUTION
[#
    [.[`\times`].]{
      rowbottom => '3',
    }
    [.[`[$a[0]]`].]
    [.[`[$a[1]]`].]*

    [.[`[$b[0]]`].]{
      rowbottom => '1',
    }
    [.[`[$p[0]]`].]
    [.[`[$p[2]]`].]*

    [.[`[$b[1]]`].]{
      rowbottom => '1',
    }
    [.[`[$p[1]]`].]
    [.[`[$p[3]]`].]
#]{
      align => 'r!{\vrule width 0.11em}c|c|',
      valign => 'middle',
}

END_PGML_SOLUTION

